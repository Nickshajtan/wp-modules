{
  "name": "hcc/attributes-injection-library",
  "description": "PHP 8 Attributes DI processing support",
  "version": "1.0.0",
  "type": "library",
  "require": {
    "php": ">=8.2",
    "composer/installers": "^1.10",
    "psr/cache": "^3.0",
    "hcc/container-library": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "HCC\\Attributes": "src/"
    }
  },
  "extra": {
    "installer-name": "hcc-attributes-injection-library"
  },
  "config": {
    "vendor-dir": "lib"
  }
}