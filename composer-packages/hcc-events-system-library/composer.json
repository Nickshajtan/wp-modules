{
  "name": "hcc/event-system-library",
  "description": "Event system to combine WordPress actions with external events support",
  "license": "MIT",
  "version": "1.0.0",
  "type": "library",
  "require": {
    "php": ">=8.2",
    "composer/installers": "^1.10",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "HCC\\Events\\": "src/"
    }
  },
  "extra": {
    "installer-name": "hcc-event-system-library"
  },
  "config": {
    "vendor-dir": "lib",
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "scripts": {
    "test": "lib/bin/phpunit --display-warnings --testsuite unit"
  }
}
