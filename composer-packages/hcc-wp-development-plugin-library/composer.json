{
  "name": "hcc/wp-development-plugin-library",
  "description": "WordPress reusable components for custom plugin development",
  "version": "1.0.0",
  "type": "library",
  "require": {
    "php": ">=8.2",
    "composer/installers": "^1.10",
    "hcc/container-library": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "HCC\\Plugin": "src/"
    }
  },
  "extra": {
    "installer-name": "hcc-wp-development-plugin-library"
  },
  "config": {
    "vendor-dir": "lib"
  }
}