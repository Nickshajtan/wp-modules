{
  "name": "hcc/container-library",
  "description": "DI Container for reusable components",
  "license": "proprietary",
  "version": "1.0.0",
  "type": "library",
  "require": {
    "php": ">=8.2",
    "composer/installers": "^1.10",
    "psr/simple-cache": "^3.0",
    "psr/container": "^2.0.2"
  },
  "autoload": {
    "psr-4": {
      "HCC\\Container\\": "src/"
    }
  },
  "extra": {
    "installer-name": "hcc-container-library"
  },
  "config": {
    "vendor-dir": "lib",
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "scripts": {
    "test": "lib/bin/phpunit"
  }
}
