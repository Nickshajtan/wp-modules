{
  "name": "hcc/development-view-library",
  "license": "MIT",
  "description": "Package for MVC view presentation",
  "type": "library",
  "require": {
    "php": ">=8.2",
    "composer/installers": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "HCC\\View\\": "src/"
    }
  },
  "extra": {
    "installer-name": "hcc-development-view-library"
  },
  "config": {
    "vendor-dir": "lib",
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "suggest": {
    "twig/twig": "Required to use Twig templates",
    "illuminate/view": "Required to use Blade templates",
    "illuminate/filesystem": "Required to use Blade templates"
  },
  "scripts": {
    "test": "lib/bin/phpunit --display-warnings --testsuite unit",
    "functional-test": [
      "composer install --working-dir=tests/functional/_dependencies --no-interaction",
      "node tests/run-functional-test.js"
    ]
  }
}
