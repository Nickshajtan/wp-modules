{
  "name": "hcc/development-attributes-library",
  "description": "PHP 8 Attributes support with reusable components",
  "version": "1.0.0",
  "type": "library",
  "require": {
    "php": ">=8.2",
    "composer/installers": "^1.10",
    "psr/simple-cache": "^3.0",
    "psr/container": "^2.0.2"
  },
  "autoload": {
    "psr-4": {
      "HCC\\Attribute": "src/"
    }
  },
  "extra": {
    "installer-name": "hcc-development-attributes-library"
  },
  "config": {
    "vendor-dir": "lib"
  }
}